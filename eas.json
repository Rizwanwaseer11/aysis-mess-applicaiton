{
  "cli": {
    "appVersionSource": "remote"
  },
    "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "AYSIS_BUILD_MODE": "production",
        "EXPO_PUBLIC_API_URL": "https://aysismess.tech/"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "AYSIS_BUILD_MODE": "production",
        "EXPO_PUBLIC_API_URL": "https://aysismess.tech/"
      }
    },

    "production": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "AYSIS_BUILD_MODE": "production",
        "EXPO_PUBLIC_API_URL": "https://aysismess.tech/"
      }
    },
    "store": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "AYSIS_BUILD_MODE": "production",
        "EXPO_PUBLIC_API_URL": "https://aysismess.tech/"
      }
    }
  }
}
