{
  "expo": {
    "name": "Aysis Mess",
    "slug": "aysis-mess-scanner",
    "version": "0.1.0",
    "userInterfaceStyle": "dark",
    "orientation": "default",
    "android": {
      "package": "com.aysismess"
    },
    "ios": {
      "bundleIdentifier": "com.aysismess",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
       "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan employee meal QR cards",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020617",
          "image": "./assets/aysis-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#020617",
            "image": "./assets/aysis-logo.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cb3decd9-e158-4fed-990f-d89a27ca5fd8"
      }
    },
    "owner": "rizwan-ahmed"
  }
}
